// Zest — PostgreSQL schema (Prisma)
// Normalized replacement for the previous Firestore document model.
// See MIGRATION_PLAN.md for the collection -> table mapping.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum PageType {
  ARTIST
  ORGANISATION
  VENUE
}

enum HandleOwnerType {
  USER
  ARTIST
  ORGANISATION
  VENUE
}

enum EventStatus {
  DRAFT
  ACTIVE
  CANCELLED
  COMPLETED
}

enum SessionStatus {
  ACTIVE
  CANCELLED
  COMPLETED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REFUNDED
}

enum TicketStatus {
  ACTIVE
  USED
  CANCELLED
  EXPIRED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  MANUAL
  FREE
}

enum CheckInMethod {
  QR
  MANUAL
}

// ---------------------------------------------------------------------------
// Identity: users, pages, and a global handle (username) registry
// ---------------------------------------------------------------------------

model User {
  id        String   @id @default(cuid())
  // Firebase UID kept during transition so existing sessions can be mapped.
  firebaseUid String? @unique @map("firebase_uid")
  email     String?  @unique
  phone     String?  @unique
  name      String?
  photo     String?
  bio       String?

  // Auth providers linked to this account.
  googleLinked Boolean @default(false) @map("google_linked")
  phoneLinked  Boolean @default(false) @map("phone_linked")
  emailLinked  Boolean @default(false) @map("email_linked")

  handle    Handle?
  pages     Page[]
  bookings  Booking[]
  tickets   Ticket[]
  events    Event[]  @relation("EventOwner")
  activities Activity[] @relation("ActivityOwner")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

// Artist / Organisation / Venue pages owned by a user.
model Page {
  id       String   @id @default(cuid())
  type     PageType
  name     String
  bio      String?
  photo    String?
  city     String?
  address  String?
  capacity Int?

  owner    User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId  String   @map("owner_id")

  handle   Handle?
  events   Event[]  @relation("EventCreatorPage")
  activities Activity[] @relation("ActivityCreatorPage")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([type])
  @@map("pages")
}

// Global username registry — guarantees uniqueness across users AND pages
// via a single unique index (replaces the old 4-collection app-level check).
model Handle {
  id        String          @id @default(cuid())
  value     String          @unique
  ownerType HandleOwnerType @map("owner_type")

  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String? @unique @map("user_id")

  page   Page?   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  pageId String? @unique @map("page_id")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("handles")
}

// ---------------------------------------------------------------------------
// Events (session-centric) -> sessions -> ticket types
// ---------------------------------------------------------------------------

model Event {
  id          String      @id @default(cuid())
  title       String
  about       String?     @map("about_event")
  venue       String?     @map("event_venue")
  image       String?     @map("event_image")
  categories  String[]    @default([])
  guides      Json?       @map("event_guides")
  status      EventStatus @default(ACTIVE)

  // Owner (the authenticated user) + the creator page (artist/org/venue).
  owner       User        @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String      @map("owner_id")
  creatorPage Page?       @relation("EventCreatorPage", fields: [creatorPageId], references: [id], onDelete: SetNull)
  creatorPageId String?   @map("creator_page_id")

  sessions    Session[]
  bookings    Booking[]
  tickets     Ticket[]

  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([ownerId])
  @@index([status])
  @@index([createdAt])
  @@map("events")
}

model Session {
  id          String        @id @default(cuid())
  event       Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId     String        @map("event_id")

  name        String
  date        DateTime      @db.Date
  startTime   String        @map("start_time")
  endTime     String        @map("end_time")
  venue       String?
  status      SessionStatus @default(ACTIVE)

  ticketTypes TicketType[]
  bookings    Booking[]
  tickets     Ticket[]

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([eventId])
  @@index([date])
  @@map("sessions")
}

// The unit of inventory. Concurrency control happens on this row:
// `capacity` is fixed, `soldCount` is incremented under a row lock.
model TicketType {
  id          String   @id @default(cuid())
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId   String   @map("session_id")

  name        String
  price       Decimal  @db.Decimal(10, 2)
  capacity    Int
  soldCount   Int      @default(0) @map("sold_count")
  description String?

  tickets     Ticket[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([sessionId])
  @@map("ticket_types")
}

// ---------------------------------------------------------------------------
// Activities (dynamic schedule-centric)
// ---------------------------------------------------------------------------

model Activity {
  id          String   @id @default(cuid())
  name        String
  location    String
  city        String?
  about       String?  @map("about_activity")
  image       String?  @map("activity_image")
  categories  String[] @default([])
  languages   String?  @map("activity_languages")
  duration    String?  @map("activity_duration")
  ageLimit    String?  @map("activity_age_limit")
  pricePerSlot Decimal @db.Decimal(10, 2) @map("price_per_slot")
  
  // JSON array of { day: string, is_open: boolean, time_slots: { start_time, end_time, capacity }[] }
  weeklySchedule Json  @map("weekly_schedule")
  closedDates   String[] @default([]) @map("closed_dates")

  owner       User     @relation("ActivityOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String   @map("owner_id")
  creatorPage Page?    @relation("ActivityCreatorPage", fields: [creatorPageId], references: [id], onDelete: SetNull)
  creatorPageId String? @map("creator_page_id")

  slots       ActivitySlot[]
  bookings    Booking[]
  tickets     Ticket[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([ownerId])
  @@map("activities")
}

// A specific materialized instance of a timeslot for a specific date
// Created lazily when the first booking for this date/time occurs.
model ActivitySlot {
  id          String   @id @default(cuid())
  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  activityId  String   @map("activity_id")
  
  date        String   // YYYY-MM-DD
  startTime   String   @map("start_time")
  endTime     String   @map("end_time")
  
  capacity    Int
  soldCount   Int      @default(0) @map("sold_count")

  bookings    Booking[]
  tickets     Ticket[]

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([activityId, date, startTime, endTime])
  @@index([activityId])
  @@map("activity_slots")
}

// ---------------------------------------------------------------------------
// Bookings -> tickets, and payments
model Booking {
  id          String        @id @default(cuid())
  status      BookingStatus @default(PENDING)
  totalAmount Decimal       @db.Decimal(10, 2) @map("total_amount")

  user        User          @relation(fields: [userId], references: [id])
  userId      String        @map("user_id")
  
  // Polymorphic relation: either Event or Activity
  event       Event?        @relation(fields: [eventId], references: [id])
  eventId     String?       @map("event_id")
  session     Session?      @relation(fields: [sessionId], references: [id])
  sessionId   String?       @map("session_id")
  
  activity    Activity?     @relation(fields: [activityId], references: [id])
  activityId  String?       @map("activity_id")
  activitySlot ActivitySlot? @relation(fields: [activitySlotId], references: [id])
  activitySlotId String?    @map("activity_slot_id")

  // Contact details captured at checkout (attendee-of-record).
  contactName  String       @map("contact_name")
  contactEmail String       @map("contact_email")
  contactPhone String       @map("contact_phone")

  tickets     Ticket[]
  payment     Payment?

  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([userId])
  @@index([eventId])
  @@index([sessionId])
  @@map("bookings")
}

// One ticket row == one attendee (merges old `eventAttendees` + `tickets`).
model Ticket {
  id            String       @id @default(cuid())
  ticketNumber  String       @unique @map("ticket_number")
  qrCode        String       @map("qr_code")
  status        TicketStatus @default(ACTIVE)

  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId     String       @map("booking_id")
  
  // For Events
  ticketType    TicketType?  @relation(fields: [ticketTypeId], references: [id])
  ticketTypeId  String?      @map("ticket_type_id")
  event         Event?       @relation(fields: [eventId], references: [id])
  eventId       String?      @map("event_id")
  session       Session?     @relation(fields: [sessionId], references: [id])
  sessionId     String?      @map("session_id")

  // For Activities
  activity      Activity?    @relation(fields: [activityId], references: [id])
  activityId    String?      @map("activity_id")
  activitySlot  ActivitySlot? @relation(fields: [activitySlotId], references: [id])
  activitySlotId String?     @map("activity_slot_id")

  // Optional link to a registered user (nullable for guest bookings).
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?      @map("user_id")

  attendeeName  String       @map("attendee_name")
  attendeeEmail String       @map("attendee_email")
  attendeePhone String       @map("attendee_phone")
  amount        Decimal      @db.Decimal(10, 2)

  // Check-in state.
  checkedIn     Boolean       @default(false) @map("checked_in")
  checkInTime   DateTime?     @map("check_in_time")
  checkInMethod CheckInMethod? @map("check_in_method")
  checkedInBy   String?       @map("checked_in_by")
  usedAt        DateTime?     @map("used_at")

  entryLogs     EntryLog[]

  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([bookingId])
  @@index([ticketTypeId])
  @@index([eventId])
  @@index([sessionId])
  @@index([userId])
  @@index([status])
  @@map("tickets")
}

model Payment {
  id                String        @id @default(cuid())
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId         String        @unique @map("booking_id")

  razorpayOrderId   String?       @map("razorpay_order_id")
  // Unique => replay-safe: the same gateway payment can never be recorded twice.
  razorpayPaymentId String?       @unique @map("razorpay_payment_id")
  razorpaySignature String?       @map("razorpay_signature")

  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod @default(RAZORPAY)

  createdAt         DateTime      @default(now()) @map("created_at")
  completedAt       DateTime?     @map("completed_at")
  refundedAt        DateTime?     @map("refunded_at")

  @@map("payments")
}

// Immutable audit trail for ticket scanning / check-in.
model EntryLog {
  id        String        @id @default(cuid())
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  ticketId  String        @map("ticket_id")
  scannedBy String        @map("scanned_by")
  method    CheckInMethod
  createdAt DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@map("entry_logs")
}
